# ── PremadeGG - Variables de Entorno ───────────────────
# Copia este archivo como .env y ajusta los valores si es necesario.
#   cp .env.example .env

# ── MongoDB ────────────────────────────────────────────
# URI de conexión (Docker usa "mongo" como hostname del servicio)
MONGO_URI=mongodb://mongo:27017/premade-gg

# ── API ────────────────────────────────────────────────
# Puerto del servidor Express
PORT=4000

# Entorno: "development" (logs detallados) | "production" (solo errores)
NODE_ENV=development

# ── Riot Games API ────────────────────────────────────
# Development Key (se obtiene en developer.riotgames.com, caduca cada 24h)
RIOT_API_KEY=RGAPI-xxxx-xxxx-xxxx-xxxx-xxxx

# ── HenrikDev API ─────────────────────────────────────
# API Key gratuita (se obtiene en docs.henrikdev.xyz)
HENRIK_API_KEY=HDEV-xxxx-xxxx-xxxx-xxxx
