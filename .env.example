# ── PremadeGG - Variables de Entorno ───────────────────
# Copia este archivo como .env y ajusta los valores si es necesario.
#   cp .env.example .env

# ── MongoDB ────────────────────────────────────────────
# URI de conexión:
#   - Docker:      mongodb://mongo:27017/premade-gg   (hostname del servicio)
#   - Local (sin Docker): mongodb://localhost:27017/premade-gg
MONGO_URI=mongodb://mongo:27017/premade-gg

# ── API ────────────────────────────────────────────────
# Puerto del servidor Express
PORT=4000

# Entorno: "development" (logs detallados) | "production" (solo errores)
NODE_ENV=development

# ── JWT ──────────────────────────────────────────────
# Secreto para firmar los tokens JWT. Cambiar en producción.
JWT_SECRET=premadegg-change-this-secret-in-production

# ── Riot Games API ────────────────────────────────────
# Development Key (se obtiene en developer.riotgames.com, caduca cada 24h)
RIOT_API_KEY=RGAPI-xxxx-xxxx-xxxx-xxxx-xxxx

# ── HenrikDev API ─────────────────────────────────────
# API Key gratuita (se obtiene en docs.henrikdev.xyz)
HENRIK_API_KEY=HDEV-xxxx-xxxx-xxxx-xxxx

# ── Brevo (Email) ─────────────────────────────────────
# API Key de Brevo para envío de correos (se obtiene en app.brevo.com)
BREVO_API_KEY=xkeysib-xxxx
# Email remitente configurado en Brevo
BREVO_SENDER_EMAIL=premadegg.bot@gmail.com

# ── Cliente ───────────────────────────────────────────
# URL del frontend (usada para CORS y redirecciones).
# En producción, separar múltiples orígenes con comas.
#   Ejemplo: https://premade-gg.vercel.app,https://www.premade.gg
CLIENT_URL=http://localhost:4200
