# Variables para scripts/migrate-mongo-to-supabase.mjs
#   cp scripts/.env.example scripts/.env
MONGO_URI=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/premade-gg
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Dashboard → Project Settings → API Keys → secret (o service_role). NUNCA en el frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: backend antiguo, para rescatar avatares de /uploads si siguen existiendo
OLD_UPLOADS_URL=https://premade-gg.onrender.com
