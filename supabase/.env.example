# Variables que lee supabase/config.toml en local (cp supabase/.env.example supabase/.env)
# Callback a registrar en Google Cloud / Discord Developer Portal:
#   http://127.0.0.1:44321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_DISCORD_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_DISCORD_SECRET=
